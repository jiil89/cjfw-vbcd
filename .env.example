# 이 파일을 복사해서 ".env"라는 이름으로 만들고, 실제 값을 채워넣으세요.
# .env는 .gitignore에 포함되어 있어 깃에 올라가지 않습니다.

# 텔레그램 봇 토큰 (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=

# LLM API 키 (OpenAI)
OPENAI_API_KEY=

# 사용할 모델 (가장 저렴한 모델로 지정, 2026-08 기준 gpt-5-nano)
OPENAI_MODEL=gpt-5-nano

# Supabase 프로젝트 정보 (Supabase 대시보드 > Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# 사내 계정 비밀번호 암호화용 키 (직접 생성, 예: openssl rand -hex 32)
CREDENTIAL_ENCRYPTION_KEY=
