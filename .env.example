# 이 파일을 복사해서 ".env"라는 이름으로 만들고, 실제 값을 채워넣으세요.
# .env는 .gitignore에 포함되어 있어 깃에 올라가지 않습니다.

# 텔레그램 봇 토큰 (BotFather에서 발급) — 향후 채널 확장용, 지금은 미사용
TELEGRAM_BOT_TOKEN=

# LLM API 키 (OpenAI)
OPENAI_API_KEY=

# 사용할 모델 (가장 저렴한 모델로 지정, 2026-08 기준 gpt-5-nano)
OPENAI_MODEL=gpt-5-nano

# Supabase 클라이언트(Auto API)용 — Admin/등록 웹페이지 등에서 필요시 사용
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# 백엔드(Express)가 pg로 Postgres에 직접 연결할 때 쓰는 커넥션 문자열.
# Vercel Functions(서버리스)는 요청마다 새 커넥션을 열 수 있으므로, 직접 연결(5432)이 아니라
# Supabase 커넥션 풀러(6543, transaction 모드/Supavisor)를 반드시 사용한다 (prompts/prd.txt 참고).
DATABASE_URL=

# 이 서비스 자체 로그인(JWT)용 서명 키. CREDENTIAL_ENCRYPTION_KEY와는 용도가 다르므로 반드시 별도 값 사용.
# 직접 생성, 예: openssl rand -hex 32
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=

# 사내 계정 비밀번호 암호화용 키 (직접 생성, 예: openssl rand -hex 32)
# 위 JWT 키들과는 완전히 다른 값이어야 함 — 이건 복호화 가능한 CJ 계정 비밀번호 암호화 전용.
CREDENTIAL_ENCRYPTION_KEY=

# CORS 허용 origin 목록 (콤마로 구분, 와일드카드 "*" 금지 — 5-project-principle.md 5번).
# Dev: 로컬 프론트(Vite) 개발 서버 origin. Vite 기본 포트가 5173이므로 우선 이 값을 쓰되,
#   실제로는 아래 Vite 프록시(BE-9 참고)를 쓰면 브라우저 기준 요청 origin이 프론트 자신의
#   origin(예: http://localhost:5173)이 되어 이 값과 일치해야 한다.
# Prd: 프론트/백엔드가 같은 Vercel 도메인으로 배포되면(same-origin) 이 값이 사실상 불필요해지지만,
#   분리 배포 시를 대비해 실제 배포 도메인을 콤마로 나열한다. 예: https://cjfw-vbcd.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
