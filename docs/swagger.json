  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "로그인 응답으로 발급된 Access Token을 `Authorization: Bearer <access_token>` 헤더로 전달한다. Refresh Token은 httpOnly 쿠키로만 전달되며 이 스킴과 무관하다."
      }
    },
    "parameters": {
      "RegistrationRequestId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "AccountRegistrationRequest의 ID",
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "요청 값이 유효하지 않음",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Unauthorized": {
        "description": "인증되지 않음 — Access Token이 없거나 만료됨",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Forbidden": {
        "description": "권한 없음 — Admin 권한이 필요한 요청을 일반 사용자가 호출함",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "NotFound": {
        "description": "리소스를 찾을 수 없음",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "description": "머신 판별용 에러 코드 (예: INVALID_CREDENTIALS, ROOM_ALREADY_BOOKED, OUT_OF_SCOPE_REQUEST)",
                "example": "ROOM_ALREADY_BOOKED"
              },
              "message": {
                "type": "string",
                "description": "사람이 읽을 수 있는 에러 메시지 (한국어)",
                "example": "요청하신 시간대에 이미 다른 예약이 있습니다."
              }
            }
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["email_alias", "corporate_password", "app_password"],
        "properties": {
          "email_alias": {
            "type": "string",
            "description": "사내 계정 ID (CJ SSO 계정 식별자)",
            "example": "hong.gildong"
          },
          "corporate_password": {
            "type": "string",
            "format": "password",
            "description": "CJ 사내 계정 비밀번호. 클라이언트는 평문으로 전송하고, 서버가 복호화 가능한 방식(AES 등)으로 암호화하여 저장한다(CJ 자동화 로그인용). app_password와 절대 혼동하지 말 것."
          },
          "app_password": {
            "type": "string",
            "format": "password",
            "description": "이 서비스 자체 로그인 비밀번호. 클라이언트는 평문으로 전송하고, 서버가 단방향 해시(bcrypt/argon2 등)로 저장한다(복호화 불가). corporate_password와 절대 혼동하지 말 것."
          },
          "preferred_room_ids": {
            "type": "array",
            "description": "선호 회의실 ID 목록. 배열 순서가 곧 우선순위(첫 번째가 1순위)다. 생략 가능.",
            "items": { "type": "string", "format": "uuid" }
          }
        }
      },
      "RegisterResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid", "description": "생성된 AccountRegistrationRequest ID" },
          "status": {
            "type": "string",
            "enum": ["pending", "auto_approved"],
            "description": "화이트리스트 매칭 시 auto_approved(즉시 로그인 가능), 아니면 pending(Admin 승인 대기)"
          },
          "message": { "type": "string", "example": "등록 신청이 접수되었습니다. 승인되면 로그인하실 수 있어요." }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email_alias", "app_password"],
        "properties": {
          "email_alias": { "type": "string", "example": "hong.gildong" },
          "app_password": {
            "type": "string",
            "format": "password",
            "description": "이 서비스 자체 로그인 비밀번호(평문 전송, 서버가 해시와 비교). CJ 사내 계정 비밀번호가 아니다."
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "짧은 만료(예: 15분)의 JWT Access Token. 클라이언트는 이 값을 메모리에만 보관하고 localStorage에는 저장하지 않는다."
          },
          "token_type": { "type": "string", "example": "Bearer" },
          "expires_in": { "type": "integer", "description": "Access Token 만료까지 남은 초", "example": 900 },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "User": {
        "type": "object",
        "description": "온보딩 승인을 마친 사용자. 비밀번호(암호화본/해시)는 API 응답에 절대 포함하지 않는다.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email_alias": { "type": "string", "example": "hong.gildong" },
          "is_admin": { "type": "boolean" },
          "status": { "type": "string", "enum": ["active", "revoked"] },
          "approved_at": { "type": "string", "format": "date-time" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "AccountRegistrationRequest": {
        "type": "object",
        "description": "회원가입 웹페이지에서 제출한 계정 등록 신청 건. 비밀번호(암호화본/해시)는 API 응답에 절대 포함하지 않는다.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email_alias": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "auto_approved", "approved", "rejected"]
          },
          "processed_by_user_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "수동 승인/거부를 처리한 Admin의 User ID (자동 승인 시 null)"
          },
          "processed_by_email_alias": {
            "type": "string",
            "nullable": true,
            "description": "수동 승인/거부를 처리한 Admin의 사내 계정 ID(표시용). 자동 승인 시 null — 프론트는 이 경우 \"system\"으로 표시한다(FE-4 와이어프레임)."
          },
          "processed_by_system": {
            "type": "boolean",
            "description": "화이트리스트에 의해 시스템이 자동 승인했는지 여부"
          },
          "processed_at": { "type": "string", "format": "date-time", "nullable": true },
          "resulting_user_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "승인 완료 시 생성된 User의 ID"
          },
          "preferred_room_ids": {
            "type": "array",
            "description": "회원가입 신청 시 선택한 선호 회의실 ID 목록. 배열 순서가 우선순위(첫 번째가 1순위).",
            "items": { "type": "string", "format": "uuid" }
          },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Room": {
        "type": "object",
        "description": "예약 가능한 사내 회의실. 1차 범위는 상암S시티, 3F·12F~16F로 고정.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "site": { "type": "string", "example": "상암S시티" },
          "area_code": { "type": "string", "description": "건물 코드 (CJ 시스템 값)" },
          "sub_area_code": { "type": "string", "description": "층 코드 (CJ 시스템 값)" },
          "room_code": { "type": "string", "description": "회의실 코드 (CJ 시스템 값, 예약 API의 실제 식별자)" },
          "room_name": { "type": "string", "example": "14F-2" },
          "floor_label": { "type": "string", "example": "14F" },
          "capacity": { "type": "integer", "nullable": true, "description": "수용 인원" },
          "is_bookable": { "type": "boolean" }
        }
      },
      "RoomWithAvailability": {
        "allOf": [
          { "$ref": "#/components/schemas/Room" },
          {
            "type": "object",
            "properties": {
              "available": {
                "type": "boolean",
                "nullable": true,
                "description": "요청한 date/start_time/end_time 조건에서 예약 가능 여부. 가용성 조회 조건을 넘기지 않은 경우 null."
              }
            }
          }
        ]
      },
      "PreferredRoom": {
        "type": "object",
        "properties": {
          "room_id": { "type": "string", "format": "uuid" },
          "priority": { "type": "integer", "description": "1이 최우선", "example": 1 },
          "room": { "$ref": "#/components/schemas/Room" }
        }
      },
      "PreferredRoomsUpdateRequest": {
        "type": "object",
        "required": ["room_ids"],
        "properties": {
          "room_ids": {
            "type": "array",
            "description": "선호 회의실 ID 목록. 배열 순서가 곧 우선순위(첫 번째가 1순위)다.",
            "items": { "type": "string", "format": "uuid" }
          }
        }
      },
      "ReservationRequest": {
        "type": "object",
        "description": "사용자가 챗봇에 입력한 예약 조건의 구조화된 원본 (가용성 조회 및 예약 생성의 입력값)",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "user_id": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "description": "회의명" },
          "contents": { "type": "string", "nullable": true, "description": "회의 내용" },
          "desired_date": { "type": "string", "format": "date" },
          "desired_start_time": { "type": "string", "format": "time" },
          "desired_end_time": { "type": "string", "format": "time" },
          "status": {
            "type": "string",
            "enum": ["received", "availability_checked", "confirmed", "conflict", "cancelled"]
          },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "MyReservationGroup": {
        "type": "object",
        "description": "[FE-5 착수 시 신규 추가, 20260814] `GET /me/reservations/today` 전용 응답 형태. `backend/src/tools/myReservations.tool.ts`의 반환 타입을 그대로 노출한다(별도 write API가 없는 읽기 전용 엔드포인트라 snake_case 변환 없이 그대로). 긴 회의가 여러 회의실로 분할된 경우 하나의 그룹으로 묶여 `segments`가 2건 이상이다.",
        "properties": {
          "reservationRequestId": { "type": "string", "format": "uuid", "nullable": true },
          "title": { "type": "string" },
          "isSplit": { "type": "boolean" },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reservationId": { "type": "string", "format": "uuid" },
                "roomName": { "type": "string", "nullable": true },
                "startAt": { "type": "string", "format": "date-time" },
                "endAt": { "type": "string", "format": "date-time" },
                "cjSeq": { "type": "string", "nullable": true }
              }
            }
          }
        }
      },
      "ChatMessageRequest": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "description": "사용자가 챗봇에 입력한 자연어 발화",
            "example": "내일 오후 2시부터 1시간 3층 회의실 잡아줘, 회의명은 데이터 아키텍처"
          }
        }
      },
      "ChatProposal": {
        "type": "object",
        "nullable": true,
        "description": "이번 턴에 서버가 마지막으로 실행한 도구 호출의 원본 결과. 프론트는 `tool` 값으로 어떤 모양의 카드를 그릴지 판단하고(예: check_availability → 회의실 선택 그리드, propose_create_reservation/propose_split_reservation → 확정 대기 카드, confirm_create_reservation/confirm_split_reservation → 예약 확정 라벨, add_preferred_room/remove_preferred_room → 사이드바 '선호 회의실' 재조회 트리거), `data`를 그 카드에 그대로 바인딩한다. 도구 목록/각 도구의 반환 필드는 `backend/src/orchestration/orchestrator.ts`의 `executeTool`이 정본이다. 대응하는 카드 UI가 없는 tool 값이면 프론트는 카드 없이 `reply` 텍스트만 보여준다.",
        "properties": {
          "tool": {
            "type": "string",
            "description": "실행된 도구 이름 (예: check_availability, propose_create_reservation, confirm_create_reservation 등)"
          },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "해당 도구의 원본 반환값 — 도구마다 형태가 다르다."
          }
        }
      },
      "ChatMessageResponse": {
        "type": "object",
        "properties": {
          "reply": {
            "type": "string",
            "description": "챗봇의 자연어 응답",
            "example": "3F-6 회의실이 비어있어서 14:00~15:00으로 예약했습니다."
          },
          "proposal": { "$ref": "#/components/schemas/ChatProposal" },
          "elapsed_ms": {
            "type": "integer",
            "description": "서버가 이 메시지를 처리하는 데 걸린 시간(ms). CJ 자동화 콜드스타트로 응답이 지연될 수 있어, 프론트가 로딩 UX를 조정하는 데 참고용으로 쓸 수 있다."
          }
        }
      },
      "RecurringReservationRule": {
        "type": "object",
        "description": "[신규] 사용자가 등록한 반복 예약 규칙. 매주 정해진 요일·시간대에 자동으로 예약을 시도한다.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "weekday": { "type": "integer", "enum": [0, 1, 2, 3, 4, 5, 6], "description": "요일 (0=일요일, 6=토요일)" },
          "start_time": { "type": "string", "format": "time", "example": "10:00" },
          "end_time": { "type": "string", "format": "time", "example": "11:00" },
          "title": { "type": "string", "description": "회의명" },
          "contents": { "type": "string", "nullable": true, "description": "회의 내용" },
          "is_active": { "type": "boolean", "description": "규칙 활성화 여부 (동의 철회 시 자동으로 false)" },
          "rooms": {
            "type": "array",
            "description": "시도 회의실 목록 (우선순위 순, 1~3개)",
            "items": {
              "type": "object",
              "properties": {
                "room_id": { "type": "string", "format": "uuid" },
                "room_name": { "type": "string", "example": "14F-2" },
                "floor_label": { "type": "string", "example": "14F" },
                "priority": { "type": "integer", "description": "1이 최우선" }
              }
            }
          },
          "latest_run": {
            "type": "object",
            "nullable": true,
            "description": "가장 최근 자동 실행 결과",
            "properties": {
              "target_date": { "type": "string", "format": "date" },
              "status": { "type": "string", "enum": ["succeeded", "failed", "skipped"], "description": "실행 결과" },
              "booked_room_name": { "type": "string", "nullable": true, "description": "성공 시 확정된 회의실명" },
              "attempted_priority": { "type": "integer", "nullable": true, "description": "마지막 시도한 우선순위" },
              "failure_reason": { "type": "string", "nullable": true, "description": "실패 사유 (예: 1순위:만석, 2순위:만석, 3순위:만석)" },
              "executed_at": { "type": "string", "format": "date-time" }
            }
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
