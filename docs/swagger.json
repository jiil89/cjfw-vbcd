    "/me/cj-world-password": {
      "patch": {
        "tags": ["Me"],
        "summary": "CJ WORLD PW 재등록 (로그인 상태)",
        "description": "[20260816 신규] 사용자가 CJ WORLD에서 비밀번호를 바꾸면 우리가 보관 중인 암호문이 낡은 값이 되어 조회/예약이 전부 실패한다. 그때 앱에도 다시 등록하는 경로. 저장 전에 새 비밀번호로 CJ에 **실제 로그인해서 검증**하고(오타 저장으로 인한 조용한 잠김 방지) 성공한 값만 저장하며, 옛 비밀번호로 맺어둔 CJ 세션 캐시를 즉시 버린다. 브라우저 자동화로 검증하므로 응답이 수 초 걸릴 수 있다. 로그인 자체가 막힌 상태(CJ_LOGIN_FAILED)라면 이 경로에 도달할 수 없으므로 `POST /auth/cj-world-password`를 쓴다.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["new_cj_world_password"],
                "properties": { "new_cj_world_password": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "재등록 성공(본문 없음)" },
          "400": {
            "description": "필수값 누락 또는 새 CJ WORLD PW로 CJ 로그인 실패(CJ_WORLD_PASSWORD_INVALID)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "사용자를 찾을 수 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "502": {
            "description": "외부 사내 예약 시스템(CJ) 연동 실패",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
