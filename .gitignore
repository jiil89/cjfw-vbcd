# dependencies
node_modules/
.pnp
.pnp.js

# testing
coverage/

# production
build/
dist/

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# 로컬에서 dev 서버를 백그라운드로 띄울 때 남는 로그
.dev-server.log
# Windows 작업 스케줄러가 반복 예약 잡(job:recurring)을 돌릴 때 남기는 실행 로그
.job.log

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# misc
.DS_Store
*.pem

# next.js
.next/
out/

# vite
.vite/

# cache
.cache/
.eslintcache
.turbo/

# playwright mcp temp artifacts (screenshots, network dumps)
.playwright-mcp/

# Vercel CLI 링크 정보 및 `vercel env pull`이 내려받는 로컬 env
# (.env 계열은 위 "env files" 절에서 이미 무시하고 있으므로 여기서 반복하지 않는다 —
#  vercel link가 자동 추가하는 `.env*`는 추적 중인 .env.example까지 걸려서 쓰지 않는다)
.vercel
